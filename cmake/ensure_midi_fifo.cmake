# Override the esp_tinyusb MIDI software FIFOs without changing the USB endpoint MPS.
set(_mystrix_tusb_config "\${PROJECT_SOURCE_DIR}/managed_components/espressif__esp_tinyusb/include/tusb_config.h")
if(NOT EXISTS "\${_mystrix_tusb_config}")
    message(FATAL_ERROR "Mystrix: esp_tinyusb header missing: \${_mystrix_tusb_config}")
endif()
file(READ "\${PROJECT_SOURCE_DIR}/main/config.h" _mystrix_config)
file(READ "\${_mystrix_tusb_config}" _before)
set(_after "\${_before}")
foreach(_dir RX TX)
    if(NOT _mystrix_config MATCHES "MIDI_\${_dir}_FIFO_BYTES[ \t]*=[ \t]*([0-9]+)")
        message(FATAL_ERROR "Mystrix: MIDI_\${_dir}_FIFO_BYTES missing in config.h")
    endif()
    set(_size "\${CMAKE_MATCH_1}")
    set(_macro "CFG_TUD_MIDI_\${_dir}_BUFSIZE")
    if(NOT _after MATCHES "#define[ \t]+\${_macro}[ \t]+([0-9]+)([ \t\r\n]|$)")
        message(FATAL_ERROR "Mystrix: \${_macro} numeric definition missing in esp_tinyusb config")
    endif()
    string(REGEX REPLACE "#define[ \t]+\${_macro}[ \t]+[0-9]+" "#define \${_macro} \${_size}" _after "\${_after}")
endforeach()
if(NOT _after STREQUAL _before)
    file(WRITE "\${_mystrix_tusb_config}" "\${_after}")
endif()
message(STATUS "Mystrix: MIDI RX/TX software FIFO = 128 B each per interface")
